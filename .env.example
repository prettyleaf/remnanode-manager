### Web UI ###
APP_PORT=3100

# Set to true when the UI is served through a reverse proxy (nginx, Caddy, ...):
# the client IP and HTTPS are then taken from X-Forwarded-* headers.
TRUST_PROXY=true

# Secure flag for the session cookie: auto | true | false.
# "auto" enables it for HTTPS requests.
COOKIE_SECURE=auto

### Administrator (optional) ###
# When both are set the account is created on start, and its password is
# reset to this value on every restart. Leave empty to create the admin
# from the web UI on first visit.
ADMIN_USERNAME=
ADMIN_PASSWORD=

### Remnawave panel (optional) ###
# Seeds the connection on first start; afterwards it is managed in the UI.
# Inside the remnawave-network the panel is reachable as http://remnawave:3000
REMNAWAVE_PANEL_URL=
REMNAWAVE_API_TOKEN=

### Misc ###
# Ask GitHub every 6 hours whether a newer release (or dev commit) exists.
UPDATE_CHECK=true
LOG_LEVEL=info
